{
  "name": "ROS2 Line Follower",
  "image": "ros:humble-ros-base",
  "postCreateCommand": "pip install torch torchvision opencv-python-headless numpy matplotlib jupyterlab --break-system-packages",
  "forwardPorts": [8888, 9090],
  "portsAttributes": {
    "8888": { "label": "Jupyter Lab" },
    "9090": { "label": "ROS Bridge" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "remoteEnv": {
    "ROS_DOMAIN_ID": "42",
    "PYTHONPATH": "/opt/ros/humble/local/lib/python3.10/dist-packages"
  }
}
