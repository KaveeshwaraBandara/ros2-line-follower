<?xml version="1.0"?>
<sdf version="1.6">
  <world name="triangle">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Bottom edge -->
    <model name="bottom">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.05 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left diagonal edge -->
    <model name="left_edge">
      <static>true</static>
      <pose>-1.5 2 0.001 0 0 0.9273</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>5.0 0.05 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right diagonal edge -->
    <model name="right_edge">
      <static>true</static>
      <pose>1.5 2 0.001 0 0 -0.9273</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>5.0 0.05 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>