<?xml version="1.0"?>
<sdf version="1.6">
  <world name="messy">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Messy / irregular winding road path going generally east.
      Robot spawns at (0,0) facing +X on the first segment.

      Waypoints (connected end-to-end):
        (0, 0.0) -> (1.5, 0.0) -> (2.0, 1.0) -> (3.5, 0.5)
               -> (4.5, 2.0) -> (6.0, 1.0) -> (7.5, 1.5)
               -> (8.5,-0.5) -> (10.0, 0.0)

      Segment lengths are extended by ~0.1 m to close gaps at junctions.
      Yaw angles (rad, rounded to 3 dp):
        0.000  1.107  -0.322   0.983  -0.588   0.322  -1.107   0.322
    -->

    <!-- Seg 1: (0,0) -> (1.5,0)  len=1.5  yaw=0 -->
    <model name="m_seg1">
      <static>true</static>
      <pose>0.75 0.0 0.001 0 0 0.000</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.60 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 2: (1.5,0) -> (2.0,1.0)  len=1.118  yaw=1.107 -->
    <model name="m_seg2">
      <static>true</static>
      <pose>1.75 0.5 0.001 0 0 1.107</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.22 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 3: (2.0,1.0) -> (3.5,0.5)  len=1.581  yaw=-0.322 -->
    <model name="m_seg3">
      <static>true</static>
      <pose>2.75 0.75 0.001 0 0 -0.322</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.68 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 4: (3.5,0.5) -> (4.5,2.0)  len=1.803  yaw=0.983 -->
    <model name="m_seg4">
      <static>true</static>
      <pose>4.0 1.25 0.001 0 0 0.983</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.90 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 5: (4.5,2.0) -> (6.0,1.0)  len=1.803  yaw=-0.588 -->
    <model name="m_seg5">
      <static>true</static>
      <pose>5.25 1.5 0.001 0 0 -0.588</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.90 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 6: (6.0,1.0) -> (7.5,1.5)  len=1.581  yaw=0.322 -->
    <model name="m_seg6">
      <static>true</static>
      <pose>6.75 1.25 0.001 0 0 0.322</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.68 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 7: (7.5,1.5) -> (8.5,-0.5)  len=2.236  yaw=-1.107 -->
    <model name="m_seg7">
      <static>true</static>
      <pose>8.0 0.5 0.001 0 0 -1.107</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.34 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg 8: (8.5,-0.5) -> (10.0,0.0)  len=1.581  yaw=0.322 -->
    <model name="m_seg8">
      <static>true</static>
      <pose>9.25 -0.25 0.001 0 0 0.322</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.68 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
