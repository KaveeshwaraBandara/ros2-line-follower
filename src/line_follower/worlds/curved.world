<?xml version="1.0"?>
<sdf version="1.6">
  <world name="curved">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Full circular loop, radius 2.5 m, centre at (0, 2.5).
      Robot spawns at (0, 0) facing +X — the bottom of the circle.
      Path is approximated by 24 chord segments (15 deg each).
      Chord length = 2 * 2.5 * sin(7.5 deg) = 0.653 m.

      Traversal direction: counter-clockwise (robot turns left continuously).
    -->

    <model name="curve_00"><static>true</static><pose>0.326 0.021 0.001 0 0 0.131</pose><link name="link"><visual name="v"><geometry><box><size>0.653 0.05 0.001</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>
